generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum OrderEvent {
  order_created
  payment_confirmed
  preparing
  packed
  guide_generated
  handed_to_carrier
  in_transit
  out_for_delivery
  delivered
  cancelled
  returned
  note_added
}

enum NotificationChannel {
  email
  whatsapp
  sms
  push
}

enum PaymentProvider {
  stripe
  wompi
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(customer)
  createdAt DateTime @default(now())

  cart   CartItem[]
  orders Order[]
  notes  OrderNote[]
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  price       Int
  category    String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())

  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventoryEvents InventoryEvent[]
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  publicId  String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  total             Int
  shippingCost      Int?
  status            OrderStatus @default(pending)
  reference         String?     @unique
  paymentStatus     String?
  paymentMethod     String?
  wompiTxId         String?     @unique
  phoneNumber       String?
  trackingNumber    String?
  carrier           String?
  shippingStatus    String?     @default("pending")
  shippingAddress   String?
  shippingCity      String?
  estimatedDelivery DateTime?
  createdAt         DateTime    @default(now())

  user            User              @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  timeline        OrderTimeline[]
  notes           OrderNote[]
  guides          ShippingGuide[]
  trackingToken   TrackingToken?
  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  provider      PaymentProvider
  status        PaymentStatus   @default(pending)
  transactionId String?
  reference     String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([reference])
}

model InventoryEvent {
  id        String   @id @default(cuid())
  productId String
  oldStock  Int
  newStock  Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model OrderTimeline {
  id        String     @id @default(cuid())
  orderId   String
  event     OrderEvent
  metadata  Json?
  createdAt DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  content   String
  authorId  String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([orderId])
}

model ShippingGuide {
  id          String   @id @default(cuid())
  orderId     String
  provider    String
  guideNumber String
  trackingUrl String?
  labelUrl    String?
  barcodeUrl  String?
  cost        Int?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([guideNumber])
  @@index([provider])
}

model TrackingToken {
  id        String   @id @default(cuid())
  orderId   String   @unique
  token     String   @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([token])
}

model NotificationLog {
  id        String             @id @default(cuid())
  orderId   String
  channel   NotificationChannel
  event     OrderEvent
  status    String
  recipient String
  metadata  Json?
  createdAt DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}
